<view class="homePage">
  <!-- banner -->
  <view class="bannerBox">
    <swiper indicator-dots="{{ false }}" autoplay="{{ true }}" interval="5000" circular="{{ true }}" bindchange="swiperChange" style="height: 460rpx;">
      <block wx:for="{{ swiperList }}" wx:key="index">
        <swiper-item>
          <view class="bannerContent">
            <view class="bannerTextBox">
              <view class="bannerTextBoxSub1">
                <image src="/images/homeModule/guoweigangtie.png" mode="" style="width: 80rpx; height: 80rpx;" />
                <view class="bannerTextBoxSub1Text">国为钢铁</view>
              </view>
              <view style="margin-top: 40rpx;">
                <view class="bannerTextBoxSub2">诚信为本 铸就品牌</view>
                <view class="bannerTextBoxSub2">优质服务 赢得市场</view>
              </view>
            </view>
            <!-- <image src="{{ baseURL + item }}" mode="" class="bannerImage" style="width: 100%; height: 382rpx;" /> -->
            <image src="{{ item }}" mode="" class="bannerImage" />
          </view>
        </swiper-item>
      </block>
    </swiper>
    <!-- banner - dian -->
    <view class="swiperDianBox frcc">
      <view wx:for="{{ swiperList.length }}" wx:key="idnex">
        <view wx:if="{{ swiperCurrent === index }}" class="swiperDianA"></view>
        <view wx:else class="swiperDianN"></view>
      </view>
    </view>
  </view>

  <!-- 卡片 -->
  <view class="cardBox frbc">
    <view class="cjcxBox" bind:tap="goSlipList">
      <image src="/images/homeModule/xiadan_icon.png" mode="" class="cjcxImg" />
      <view class="frcc">
        <view class="cjcxText">下单</view>
        <image src="/images/homeModule/youjiantoubaise.png" mode="" style="margin-left: 16rpx; width: 40rpx; height: 40rpx;" />
      </view>
    </view>
    <view class="rightBox fcbc">
      <view class="cjfxBox frbc" bind:tap="goInventorySearch">
        <view class="frcc" style="margin-top: 80rpx;">
          <view class="rightText">库存</view>
          <image src="/images/homeModule/youjiantoubaise.png" mode="" style="margin-left: 12rpx; width: 30rpx; height: 30rpx;" />
        </view>
        <image src="/images/homeModule/kucun_icon.png" mode="" style="width: 80rpx; height: 80rpx;" />
      </view>
      <view class="djdkBox frbc" bind:tap="goMyReceivable">
        <view class="frcc" style="margin-top: 80rpx;">
          <view class="rightText">应收</view>
          <image src="/images/homeModule/youjiantoubaise.png" mode="" style="margin-left: 12rpx; width: 30rpx; height: 30rpx;" />
        </view>
        <image src="/images/homeModule/xiadan_icon.png" mode="" style="width: 80rpx; height: 80rpx;" />
      </view>
    </view>
  </view>

  <!-- 公告通知通报 -->
  <view class="noticeBox">
    <view class="gonggaoTitleBox">通知公告</view>
    <view wx:for="{{ noticeData }}" wx:key="index" class="noticeItem" style="{{ noticeData.length === index + 1 ? 'border: 0;' : '' }}" bind:tap="goNoticeDetail" data-item="{{ item }}">
      <image src="/images/homeModule/notice1.png" mode="aspectFill" style="width: 280rpx; height: 180rpx; border-radius: 10rpx;" />
      <view class="noticeItemInfo">
        <view class="noticeItemTitle to1">{{ item.title }}</view>
        <view class="noticeItemInfoText to2">{{ item.updated_at }}</view>
        <view class="noticeItemChakan">查看 →</view>
      </view>
    </view>
    <view wx:if="{{ noticeData && noticeData.length === 0 }}">
      <image src="/images/systemModule/zwsj.png" mode="aspectFill" />
    </view>
    <view wx:else class="chakangengduo" bind:tap="goNoticeList">
      查看更多
    </view>
  </view>
</view>