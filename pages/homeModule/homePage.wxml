<view class="homePage">
  <!-- banner -->
  <view class="bannerBox">
    <swiper indicator-dots="{{ false }}" autoplay="{{ true }}" interval="5000" circular="{{ true }}" bindchange="swiperChange" style="height: 382rpx;">
      <block wx:for="{{ swiperList }}" wx:key="index">
        <swiper-item>
          <image src="{{ baseURL + item }}" mode="" class="bannerImage" style="width: 100%; height: 382rpx;" />
        </swiper-item>
      </block>
    </swiper>
    <!-- banner - dian -->
    <view class="swiperDianBox frcc">
      <view wx:for="{{ swiperList.length }}" wx:key="idnex">
        <view wx:if="{{ swiperCurrent === index }}" class="swiperDianA"></view>
        <view wx:else class="swiperDianN"></view>
      </view>
    </view>
  <!-- 卡片 -->
  <view class="cardBox frcc">
    <view class="cjcxBox fcbc" bind:tap="goMkPage">
      <image src="/images/homeModule/cjcx.png" mode="" class="cjcxImg" />
      <view class="cjcxText">成绩查询</view>
      <view class="cjcxQuery">查询 ></view>
    </view>
    <view class="rightBox fcbc">
      <view class="cjfxBox frbs" bind:tap="goMsgPage">
        <view>
          <view class="rightText">联系学生</view>
          <view class="rightView1 frcc">送物品、临时约见</view>
        </view>
        <image src="/images/homeModule/lxxs.png" mode="" style="width: 87rpx; height: 87rpx;" />
      </view>
      <view class="djdkBox frbs" bind:tap="goCheckPage">
        <view>
          <view class="rightText">到家打卡</view>
          <view class="rightView2 frcc">查看</view>
        </view>
        <image src="/images/homeModule/djdk.png" mode="" style="width: 87rpx; height: 87rpx;" />
      </view>
    </view>
  </view>
  </view>
  <!-- 公告通知通报 -->
  <view class="noticeBox">
    <view class="gonggaoTitleBox">
      <view class="gonggaoShu"></view>
      <view class="gonggaoTitle">信息公示</view>
    </view>
    <view class="noticeItemBox">
      <view class="tabsMore">
        <view class="tabsBox">
          <view class="{{ noticetype === '1' ? 'tabsActive frcc' : 'tabsItem frcc' }}" bind:tap="tabChange" data-code="1">公告通知通报</view>
          <view class="{{ noticetype === '2' ? 'tabsActive frcc' : 'tabsItem frcc' }}" bind:tap="tabChange" data-code="2">涉企政策法规</view>
        </view>
        <view class="moreText" bind:tap="goNoticeList">更多></view>
      </view>
      <view wx:for="{{ noticeData }}" wx:key="index" class="noticeItem" style="{{ noticeData.length === index + 1 ? 'border: 0;' : '' }}" bind:tap="goNoticeDetail" data-item="{{ item }}">
        <!-- <image wx:if="{{ item.image }}" src="{{ baseURL + item.image }}" mode="aspectFill" style="width: 219rpx; height: 180rpx;" />
        <image wx:else src="/images/systemModule/zwtp.png" mode="aspectFill" style="width: 219rpx; height: 180rpx;" /> -->
        <view class="noticeItemInfo">
          <view class="noticeItemTitle">{{ item.title }}</view>
          <view class="noticeItemDate">{{ item.post_date }}</view>
        </view>
      </view>
      <view wx:if="{{ noticeData && noticeData.length === 0 }}">
        <image src="/images/systemModule/zwsj.png" mode="aspectFill" />
      </view>
    </view>
  </view>
</view>