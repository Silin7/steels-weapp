.homePage {
  min-height: 100vh;
  background-color: rgba(232, 238, 255, 1);
}

.bannerContent {
  position: relative;
  width: 100%;
  height: 460rpx;
}

.bannerTextBox {
  position: absolute;
  width: 100%;
  height: 460rpx;
  top: 0;
  left: 0;
}

.bannerTextBoxSub1 {
  margin-top: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.bannerTextBoxSub1Text {
  margin-left: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0px;
  background: linear-gradient(180deg, rgba(207, 241, 255, 1) 0%, rgba(98, 255, 255, 1) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.bannerTextBoxSub2 {
  margin-top: 10rpx;
  text-shadow: 0px 2px 2px rgba(0, 0, 0, 0.25);
  font-size: 64rpx;
  line-height: 64rpx;
  font-weight: 700;
  letter-spacing: 0px;
  text-align: center;
  color: #fff;
  /* background: linear-gradient(90deg, rgba(255, 255, 255, 1) 0%, rgba(24, 59, 88, 0.6) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent; */
}

.bannerImage {
  width: 100%;
  height: 460rpx;
}

.swiperDianBox {
  width: 100%;
  position: absolute;
  top: 420rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.swiperDianN {
  margin: 0 5rpx;
  width: 80rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
}

.swiperDianA {
  margin: 0 5rpx;
  width: 80rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 1);
  border-radius: 4rpx;
}

.subBox {
  position: absolute;
  top: 320rpx;
  left: 20rpx;
  /* margin: 20rpx 0 0 20rpx; */
  height: 245rpx;
  width: calc(100% - 40rpx);
  border-radius: 24rpx;
  background-color: #fff;
}

.dividerShu {
  width: 2rpx;
  height: 165rpx;
  background-color: #e9e9e9;
}

.subItem {
  width: 40%;
}

.sbuText {
  margin-top: 20rpx;
  line-height: 50rpx;
  font-size: 30rpx;
  font-weight: Bold;
  font-family: PingFang-SC-Bold;
  color: #373737;
}

.noticeBox {
  margin-top: 20rpx;
