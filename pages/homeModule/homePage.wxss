  height: 70rpx;
  border-radius: 13rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 31rpx;
  color: #293247;
  line-height: 31rpx;
  background: #EDF5FF;
}

.noticeItem {
  margin: 40rpx;
  padding-bottom: 40rpx;
  display: flex;
  border-bottom: 1rpx dashed rgba(204, 204, 204, 1);
}

.noticeItemInfo {
  margin-left: 20rpx;
  width: calc(100% - 300rpx);
}

.noticeItemTitle {
  margin-top: 10rpx;
