  line-height: 58rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  color: rgba(35, 65, 191, 1);
  border: 1rpx solid rgba(35, 65, 191, 1);
}

.cardBox {
  padding: 20rpx;
  background-color: #fff;
}

