  margin-left: 18rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 40rpx;
  color: #1446A7;
  line-height: 40rpx;
}

.noticeItemBox {
  margin: 0 20rpx;
  padding: 40rpx 31rpx;
  border-radius: 24rpx;
  background-color: #fff;
}

.tabsMore {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tabsBox {
  display: flex;
}

.moreText {
  padding: 8rpx;
  color: #646566;
  font-size: 24rpx;
}

.tabsActive {
  margin-right: 25rpx;
  width: 236rpx;
  height: 70rpx;
  border-radius: 13rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 31rpx;
  color: #FFFFFF;
  line-height: 31rpx;
  background: linear-gradient(90deg, rgba(42, 122, 249, 0.85), rgba(20, 70, 167, 0.85));
}

.tabsItem {
  margin-right: 25rpx;
