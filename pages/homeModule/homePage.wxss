  background-color: #fff;
}

.gonggaoTitleBox {
  padding: 60rpx 0 20rpx 40rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 0px;
  line-height: 36rpx;
  color: rgba(0, 0, 0, 1);
}

