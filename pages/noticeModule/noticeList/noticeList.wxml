<scroll-view scroll-y="{{ true }}" refresher-enabled="{{ true }}" refresher-triggered="{{ triggered }}" bindrefresherrefresh="permessagerePull" bindscrolltolower="onScrollBottom" style="height: 100vh;">
  <view class="noticeListPage">
    <view wx:for="{{ noticeData }}" wx:key="index" class="noticeItem" style="{{ noticeData.length === index + 1 ? 'border: 0;' : '' }}" bind:tap="goNoticeDetail" data-item="{{ item }}">
      <image src="/images/homeModule/notice1.png" mode="aspectFill" style="width: 280rpx; height: 180rpx; border-radius: 10rpx;" />
      <view class="noticeItemInfo">
        <view class="noticeItemTitle to1">{{ item.title }}</view>
        <view class="noticeItemInfoText to2">{{ item.content }}</view>
        <view class="noticeItemChakan">查看 →</view>
      </view>
    </view>
    <view wx:if="{{ noticeData && noticeData.length === 0 }}" class="nodataBox">
      <image src="/images/systemModule/zwsj.png" mode="aspectFill" />
    </view>
  </view>
</scroll-view>