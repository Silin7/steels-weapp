.noticeListPage {
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 1);
}

.noticeItem {
  padding: 30rpx 0;
  display: flex;
  border-bottom: 1rpx dashed rgba(204, 204, 204, 1);
}

.noticeItemInfo {
  margin-left: 20rpx;
  width: calc(100% - 300rpx);
}

.noticeItemTitle {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0px;
  line-height: 32rpx;
  color: rgba(36, 65, 191, 1);
}

.noticeItemInfoText {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  color: rgba(102, 102, 102, 1);
}

.noticeItemChakan {
  margin-top: 20rpx;
  font-size: 24rpx;
  letter-spacing: 0px;
  line-height: 24rpx;
  color: rgba(255, 93, 50, 1);
}