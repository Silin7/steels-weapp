<van-popup show="{{pickerShow}}" position="bottom">
	<view class="fieldView">
		<van-field value="{{ companycode }}" placeholder="请输入公司编号" border="{{ true }}" clearable="{{ true }}" input-align="center" bind:change="codeChange" style="border: 1rpx solid #f1f1f1;" />
		<van-field value="{{ customername }}" placeholder="请输入公司名称" border="{{ true }}" clearable="{{ true }}" input-align="center" bind:change="nameChange" style="margin-left: 10rpx; border: 1rpx solid #f1f1f1;" />
		<view class="queryBtn" bind:tap="queryBtn">查询</view>
	</view>
	<van-picker show-toolbar title="选择企业" columns="{{customerList}}" bind:cancel="onCancel" bind:confirm="onConfirm" item-height="50" />
</van-popup>