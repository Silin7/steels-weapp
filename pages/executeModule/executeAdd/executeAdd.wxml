<!-- 选择企业 -->
<component-fuzzyPicker pickerShow="{{ companiesShow }}" defaultValue="{{ executeAddForm.company_name }}" bind:confirmItem="confirmCompanies" />
<!-- 选择部门 -->
<component-choosePicker pickerShow="{{ departmentShow }}" pickerTitle="选择部门" dataList="{{ departmentList }}" bind:confirmItem="confirmDepartment" />
<!-- 选择处罚类 -->
<component-multiPicker pickerShow="{{ punishShow }}" pickerTitle="选择处罚类" dataList="{{ punishList }}" bind:changeItem="checkPunish" bind:confirmItem="confirmPunish" />

<view class="executeAddPage">
  <!-- 选择企业 -->
  <view class="enterpriseBox frbc">
    <view class="itemTitle">选择企业</view>
    <view class="frcc">
      <input value="{{ executeAddForm.company_name }}" class="enterpriseInput" placeholder-class="placeholderClass" placeholder="请选择" disabled bind:tap="chooseCompanies" />
      <image src="/images/reportModule/youjiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
    </view>
  </view>
  <!-- 牵头执法人员 -->
  <view class="enterpriseBox frbc">
    <view class="itemTitle">牵头执法人员</view>
    <view class="frcc">
      <input value="{{ executeAddForm.staffs }}" class="enterpriseInput" placeholder-class="placeholderClass" placeholder="请输入" bind:input="staffsInput" />
    </view>
  </view>
  <!-- 是否联合执法 -->
  <view class="enforcementBox">
    <view class="frbc">
      <view class="itemTitle" bind:tap="tipsPopupShow">是否联合执法</view>
      <view class="frcc">
        <view wx:if="{{ executeAddForm.is_joined }}" class="switchChecked">是</view>
        <view wx:else class="unswitchChecked">否</view>
        <van-switch checked="{{ executeAddForm.is_joined }}" size="30rpx" active-color="#1446A7" inactive-color="#ccc" bind:change="isJointChange" style="height: 34rpx;" />
      </view>
    </view>
    <view wx:for="{{ executeAddForm.joint_departments }}" wx:key="index">
      <view class="jointlawBox frbc">
        <input value="{{ item.name }}" class="lawEnforcementCs" placeholder-class="placeholderClass" placeholder="联合执法部门" disabled bind:tap="chooseDepartment" data-index="{{ index }}" />
        <image src="/images/executeModule/xiajiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
      </view>
      <view class="lawEnforcerTitle">执法人员</view>
      <view class="lawEnforcerBox">
        <input value="{{ item.staffs }}" class="lawEnforcerCs" placeholder-class="placeholderClass" placeholder="例: 张三 科长 15166854587" bind:input="lawEnforcerInput" data-index="{{ index }}" />
        <image wx:if="{{ index === 0 }}" src="/images/executeModule/add.png" mode="aspectFill" class="lawEnforcerAdd" bind:tap="departmentsAdd" />
        <image wx:else src="/images/executeModule/minussign.png" mode="aspectFill" class="lawEnforcerAdd" bind:tap="departmentsDelete" data-index="{{ index }}" />
      </view>
    </view>
  </view>
  <view class="enterpriseBox frbc">
    <view class="itemTitle">入企执法人数</view>
    <view class="frcc" style="width: calc(100% - 180rpx);">
      <input type="number" value="{{ executeAddForm.staffs_count }}" class="enterpriseInput" placeholder-class="placeholderClass" placeholder="请输入" bind:input="peopleNumInput" />
      <view class="peopleNum">人</view>
    </view>
  </view>
  <view class="describeBox">
    <view class="itemTitle">入企事由</view>
    <view class="textareaBox">
      <textarea value="{{ executeAddForm.reason }}" class="describeTextarea" placeholder-class="placeholderClass" placeholder="请输入" auto-height bind:input="describeInput" />
    </view>
  </view>
  <view class="describeBox">
    <view class="frbc">
      <view class="itemTitle">企业陪同人员</view>
      <!-- <view class="addtext" bind:tap="entourageAdd">+增加</view> -->
    </view>
    <input value="{{ executeAddForm.company_staffs }}" class="entourageCs" placeholder-class="placeholderClass" placeholder="例: 张三 15166854587" bind:input="entourageInput" />
  </view>
  <view class="describeBox">
    <view class="frbc">
      <view class="itemTitle">检查结果上传</view>
      <!-- <view class="shareBtn frcc">分享</view> -->
      <view class="shareBtn"></view>
    </view>
    <view class="frbc">
      <view class="resultTag frcc {{ executeAddForm.result_type === '整改类' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="整改类">整改类</view>
      <view class="resultTag frcc {{ executeAddForm.result_type === '处罚类' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="处罚类">处罚类</view>
      <view class="resultTag frcc {{ executeAddForm.result_type === '无问题' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="无问题">无问题</view>
      <view class="resultTag frcc {{ executeAddForm.result_type === '其他' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="其他">其他</view>
    </view>
    <!-- 选择处罚类 -->
    <view wx:if="{{executeAddForm.result_type === '处罚类'}}">
      <view class="enterpriseBox2 frbc mt20">
        <view class="itemTitle">选择处罚类</view>
        <view class="frcc">
          <input value="{{ executeAddForm.punish_str }}" class="enterpriseInput" placeholder-class="placeholderClass" placeholder="请选择" disabled bind:tap="choosePunish" />
          <image src="/images/reportModule/youjiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
        </view>
      </view>
    </view>
    <!-- 罚款金额 -->
    <view wx:if="{{ executeAddForm.moneyShow }}">
      <view class="enterpriseBox2 frbc">
        <view class="itemTitle">罚款金额</view>
        <view class="frcc">
          <input value="{{ executeAddForm.punish_money }}" class="enterpriseInput" placeholder-class="placeholderClass" placeholder="请输入" bind:input="moneyTextInput" />
        </view>
      </view>
    </view>
    <view wx:if="{{ executeAddForm.result_type !== '其他' }}">
      <view class="textareaBox">
        <textarea value="{{ executeAddForm.result }}" class="describeTextarea" placeholder-class="placeholderClass" placeholder="请输入" auto-height bind:input="resultTextInput" />
      </view>
      <view class="uploadImgBox">
        <view wx:for="{{ executeAddForm.attachments }}" wx:key="index" class="dib uploadImgFlag">
          <image src="/images/reportModule/close.png" class="closeImg" bind:tap="deleteImg" data-index="{{ index }}" />
          <image src="https://api.gxrqzfsm.com{{ item.url }}" mode="aspectFill" class="uploadImg" bind:tap="previewImage" data-url="{{ item.url }}" />
        </view>
        <image src="/images/reportModule/upload.png" class="uploadImg" bind:tap="chooseFiles" />
      </view>
    </view>
  </view>
  <view class="saveBtn frcc" bind:tap="submitBtn">提交</view>
</view>

<!-- 执法高频提醒 -->
<van-overlay show="{{ tipsShow }}" bind:click="tipsPopupClose" />
<view wx:if="{{ tipsShowLag }}" class="tipsPopupBox">
  <view class="fccc">
    <view class="tipsClose frec" bind:tap="tipsPopupClose">
      <image src="/images/executeModule/close.png" mode="aspectFill" style="width: 66rpx; height: 66rpx;" />
    </view>
    <view class="dialogBox">
      <image src="/images/executeModule/gaopin.png" mode="aspectFill" style="width: 635rpx; height: 280rpx;" />
      <view class="tipsBtnsBox">
        <view wx:if="{{ highFrequency.a }}" class="tipsInfo1">{{ highFrequency.a }}</view>
        <view wx:if="{{ highFrequency.b }}" class="tipsInfo2">{{ highFrequency.b }}</view>
        <view wx:if="{{ highFrequency.c }}" class="tipsInfo3">{{ highFrequency.c }}</view>
        <view class="tipsBtns frbc">
          <view class="jixuZhifa frcc" bind:tap="continueZf">继续执法</view>
          <view class="fangqiZhifa frcc" bind:tap="giveupZf">放弃执法</view>
        </view>
      </view>
    </view>
  </view>
</view>