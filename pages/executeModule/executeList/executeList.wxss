.executeListPage {
  padding: 22rpx 20rpx;
  min-height: 100vh;
  background-color: #F0F5F9;
}

.executeBox {
  margin-bottom: 22rpx;
  padding: 45rpx 35rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
}

.enterpriseName {
  font-size: 30rpx;
  font-weight: bold;
  font-family: PingFang SC;
  color: #1446A7;
}

.describe {
  margin-top: 25rpx;
  font-weight: 400;
  font-size: 31rpx;
  font-family: PingFang SC;
  color: #333333;
}

.infoBox {
  margin-top: 50rpx;
}

.isJoint {
  flex-shrink: 0;
  width: 59rpx;
  height: 138rpx;
  font-weight: 500;
  font-size: 28rpx;
  line-height: 28rpx;
  font-family: PingFang SC;
  border-radius: 11rpx 0rpx 0rpx 11rpx;
  color: #FFFFFF;
  background: #FC8D16;
}

.noJoint {
  width: 20rpx;
  height: 138rpx;
  border-radius: 11rpx 0rpx 0rpx 11rpx;
  color: #FFFFFF;
  background: #65A4F2;
}

.typeDate {
  padding-left: 52rpx;
  width: 100%;
  height: 138rpx;
  background-color: #F7F9FD;
  border-radius: 0rpx 11rpx 11rpx 0rpx;
}

.typeDateLabel {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 48rpx;
  font-family: PingFang SC;
  color: #666666;
}