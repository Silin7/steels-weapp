<scroll-view scroll-y="{{ true }}" refresher-enabled="{{ true }}" refresher-triggered="{{ triggered }}" bindrefresherrefresh="permessagerePull" bindscrolltolower="onScrollBottom" style="height: 100vh;">
  <view class="executeListPage">
    <view wx:for="{{ executeList }}" wx:key="index" class="executeBox" bind:tap="goExecuteUpdate" data-item="{{ item }}">
      <view class="enterpriseName">{{ item.company.name }}</view>
      <view class="describe">{{ item.reason }}</view>
      <view class="infoBox frsc">
        <view wx:if="{{ item.is_joined }}" class="isJoint fccc">
          <view>联</view>
          <view>合</view>
          <view>执</view>
          <view>法</view>
        </view>
        <view wx:else class="noJoint"></view>
        <view class="typeDate frsc">
          <view>
            <view class="typeDateLabel">结果类型</view>
            <view class="typeDateLabel">入企时间</view>
          </view>
          <view style="margin-left: 73rpx;">
            <view class="typeDateLabel">其他</view>
            <view class="typeDateLabel">{{ item.create_date }}</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{ executeList.length === 0 }}" class="nodataBox">
      <image src="/images/systemModule/zwsj.png" mode="aspectFill"/>
    </view>
  </view>
</scroll-view>