
<!-- 选择处罚类 -->
<component-multiPicker pickerShow="{{ punishShow }}" pickerTitle="选择处罚类" dataList="{{ punishList }}" bind:changeItem="checkPunish" bind:confirmItem="confirmPunish" />

<view class="executeAddPage">
  <view class="describeBox">
    <view class="frbc">
      <view class="itemTitle">检查结果上传</view>
      <view class="shareBtn"></view>
    </view>
    <view class="frbc">
      <view class="resultTag frcc {{ executeUpdateForm.result_type === '整改类' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="整改类">整改类</view>
      <view class="resultTag frcc {{ executeUpdateForm.result_type === '处罚类' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="处罚类">处罚类</view>
      <view class="resultTag frcc {{ executeUpdateForm.result_type === '无问题' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="无问题">无问题</view>
      <view class="resultTag frcc {{ executeUpdateForm.result_type === '其他' ? 'selectedTagColor' : 'unselectedTagColor' }}" bind:tap="resultTagClick" data-tag="其他">其他</view>
    </view>
    <!-- 选择处罚类 -->
    <view wx:if="{{executeUpdateForm.result_type === '处罚类'}}">
      <view class="enterpriseBox2 frbc mt20">
        <view class="itemTitle">选择处罚类</view>
        <view class="frcc">
          <input value="{{ executeUpdateForm.punish_str }}" class="enterpriseInput" placeholder-class="placeholderClass" placeholder="请选择" disabled bind:tap="choosePunish" />
          <image src="/images/reportModule/youjiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
        </view>
      </view>
    </view>
    <!-- 罚款金额 -->
    <view wx:if="{{ executeUpdateForm.moneyShow }}">
      <view class="enterpriseBox2 frbc">
        <view class="itemTitle">罚款金额</view>
        <view class="frcc">
          <input value="{{ executeUpdateForm.punish_money }}" class="enterpriseInput" placeholder-class="placeholderClass" placeholder="请输入" bind:input="moneyTextInput" />
        </view>
      </view>
    </view>
    <view wx:if="{{ executeUpdateForm.result_type !== '其他' }}">
      <view class="textareaBox">
        <textarea value="{{ executeUpdateForm.result }}" class="describeTextarea" placeholder-class="placeholderClass" placeholder="请输入" auto-height bind:input="resultTextInput" />
      </view>
      <view class="uploadImgBox">
        <view wx:for="{{ executeUpdateForm.attachments }}" wx:key="index" class="dib uploadImgFlag">
          <image src="/images/reportModule/close.png" class="closeImg" bind:tap="deleteImg" data-index="{{ index }}" />
          <image src="https://api.gxrqzfsm.com{{ item.url }}" mode="aspectFill" class="uploadImg" bind:tap="previewImage" data-url="{{ item.url }}" />
        </view>
        <image src="/images/reportModule/upload.png" class="uploadImg" bind:tap="chooseFiles" />
      </view>
    </view>
  </view>
  <view class="saveBtn frcc" bind:tap="submitBtn">提交</view>
</view>