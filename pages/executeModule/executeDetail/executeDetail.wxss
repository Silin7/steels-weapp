.executeDetailPage {
  padding: 22rpx 20rpx;
  min-height: 100vh;
  background-color: #F0F5F9;
}

.enforcementRecords {
  margin-bottom: 36rpx;
  padding: 50rpx 42rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
}

.companyName {
  font-size: 42rpx;
  font-weight: bold;
  font-family: PingFang SC;
  color: #1446A7;
}

.subjectMatter {
  margin: 42rpx 0 64rpx;
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: bold;
  font-family: PingFang SC;
  color: #333333;
}

.recordsItem {
  margin: 0 40rpx 15rpx 40rpx;
}

.recordsLable {
  flex-shrink: 0;
  width: 204rpx;
  height: 73rpx;
  font-size: 31rpx;
  font-weight: bold;
  font-family: PingFang SC;
  border-radius: 11rpx 0rpx 0rpx 11rpx;
  color: #FFFFFF;
  background: #249AEC;
}

.recordsValue {
  padding-left: 68rpx;
  width: calc(100% - 204rpx);
  height: 73rpx;
  font-size: 30rpx;
  font-weight: bold;
  font-family: PingFang SC;
  border-radius: 0rpx 11rpx 11rpx 0rpx;
  color: #666666;
  background: #ECF2FF;
}

.subjectMatter {
  padding: 44rpx 30rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
}

.masterName {
  margin-left: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  font-family: PingFang SC;
  color: #1446A7;
}

.jointZf {
  width: 142rpx;
  height: 43rpx;
  font-weight: 500;
  font-size: 28rpx;
  font-family: PingFang SC;
  border-radius: 21rpx;
  color: #FFFFFF;
  background: #FC8D16;
}

.masterItem {
  margin-top: 30rpx;
  padding-left: 50rpx;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 500;
  font-family: PingFang SC;
  color: #333333;
}

.masterItem:first-child {
  margin-top: 45rpx;
}

.shareBtn {
  margin: 85rpx 74rpx 0;
  height: 104rpx;
  font-size: 36rpx;
  font-weight: 500;
  font-family: PingFang SC;
  border-radius: 52rpx;
  color: #FFFFFF;
  background: #FC8816;
}

.sharePopupBox {
  box-sizing: border-box;
  position: fixed;
  top: 60vw;
  z-index: 9999999;
}

.shareFlex {
  width: calc(100vw - 40rpx);
}

.shareClose {
  width: 556rpx;
  height: 66rpx;
  position: relative;
}

.dialogBox {
  position: relative;
}

.sharePasswordBox {
  position: absolute;
  width: 407rpx;
  height: 200rpx;
  top: 150rpx;
  left: 70rpx;
}

.sharePassword {
  width: 407rpx;
  height: 200rpx;
}

.passwordText {
  font-size: 68rpx;
  font-weight: 800;
  color: #000000;
  font-family: PingFang SC;
}

.copyBtn {
  margin-top: 10rpx;
  width: 187rpx;
  height: 55rpx;
  font-size: 28rpx;
  font-weight: 500;
  font-family: PingFang SC;
  border-radius: 28rpx;
  color: #FFFFFF;
  background: #FC8816;
}