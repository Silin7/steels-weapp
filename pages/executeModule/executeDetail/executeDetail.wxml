<view class="executeDetailPage">
  <view class="enforcementRecords">
    <view class="companyName">{{ executeForm.company.name }}</view>
    <view class="subjectMatter">
      <text style="color: #E50000;">入企事由：</text>
      <text>{{ executeForm.reason }}</text>
    </view>
    <view class="recordsItem frsc">
      <view class="recordsLable frcc">入企时间</view>
      <view class="recordsValue frsc">{{ executeForm.create_date }}</view>
    </view>
    <view class="recordsItem frsc">
      <view class="recordsLable frcc">执法人数</view>
      <view class="recordsValue frsc">{{ executeForm.staffs_count }}</view>
    </view>
    <view class="recordsItem frsc">
      <view class="recordsLable frcc">结果类型</view>
      <view class="recordsValue frsc">其他</view>
    </view>
  </view>
  <view class="subjectMatter">
    <view class="frbc">
      <view class="frsc">
        <image src="/images/executeModule/ling.png" mode="aspectFill" style="width: 32rpx; height: 22rpx;" />
        <view class="masterName">执法人员</view>
      </view>
      <view wx:if="{{ executeForm.is_joined }}" class="jointZf frcc">联合执法</view>
    </view>
    <view wx:for="{{ executeForm.departments }}" wx:key="index" class="masterItem frsc">
      <view>{{ item.description }}</view>
    </view>
    <view class="frbc" style="margin-top: 94rpx;">
      <view class="frsc">
        <image src="/images/executeModule/ling.png" mode="aspectFill" style="width: 32rpx; height: 22rpx;" />
        <view class="masterName">企业陪同人员</view>
      </view>
    </view>
    <view wx:key="index" class="masterItem frsc">
      <view>{{ executeForm.company_staffs }}</view>
    </view>
    <view class="shareBtn frcc" bind:tap="sharePopupShow">分享给其他执法人员</view>
  </view>
  <van-overlay show="{{ shareShow }}" bind:click="sharePopupClose" />
  <view wx:if="{{ shareShowLag }}" class="sharePopupBox">
    <view class="shareFlex fccc">
      <view class="shareClose frec" bind:tap="sharePopupClose">
        <image src="/images/executeModule/close.png" mode="aspectFill" style="width: 66rpx; height: 66rpx;" />
      </view>
      <view class="dialogBox">
        <image src="/images/executeModule/dialog.png" mode="aspectFill" style="width: 556rpx; height: 407rpx;" />
        <view class="sharePasswordBox">
          <view class="sharePassword fccc">
            <view class="passwordText">{{ sharePassword }}</view>
            <view class="copyBtn frcc" bind:tap="copyText">一键复制</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>