<view style="padding: 20rpx;">
	<view class="tableHeader frbc">
		<view class="headerItem">仓库</view>
		<view class="headerItem">存货</view>
		<view class="headerItem">规格型号</view>
		<view class="headerItem">主数量</view>
		<view class="headerItem">辅数量</view>
	</view>
	<view class="tableBody frbc" wx:for="{{ inventoryList }}" wx:key="index">
		<view class="bodyItem">{{ item.WarehouseName }}</view>
		<view class="bodyItem">{{ item.InventoryName }}</view>
		<view class="bodyItem">{{ item.Specification }}</view>
		<view class="bodyItem">{{ item.AvailableQuantity }} {{ item.UnitName }}</view>
		<view class="bodyItem"></view>
	</view>
</view>