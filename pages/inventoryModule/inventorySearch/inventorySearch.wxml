<!-- 选择公司 -->
<component-choosePicker pickerShow="{{ allcompanyShow }}" pickerTitle="选择公司" dataList="{{ allcompanyList }}" bind:confirmItem="confirmAllcompany" />
<!-- 选择仓库 -->
<component-choosePicker pickerShow="{{ cangkuShow }}" pickerTitle="选择仓库" dataList="{{ cangkuList }}" bind:confirmItem="confirmCangku" />

<view class="inventorySearchPage">
	<view class="gengxinshijian">{{ inventory_update_time }}</view>
	<view class="cardBox">
		<view class="searchItem frbc">
			<view class="itemTitle">销售公司：</view>
			<view class="frcc">
				<input value="{{ supplier_name }}" class="searchInput" placeholder-class="placeholderClass" placeholder="请选择销售公司" disabled bind:tap="allcompanyShowFunction" />
				<image src="/images/salesModule/xiajiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
			</view>
		</view>
		<view class="searchItem frbc">
			<view class="itemTitle">仓库：</view>
			<view class="frcc">
				<input value="{{ searchForm.warehouse_name }}" class="searchInput" placeholder-class="placeholderClass" placeholder="请选择仓库" disabled bind:tap="cangkuShowFunction" />
				<image src="/images/salesModule/xiajiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
			</view>
		</view>
		<view class="searchItem frbc">
			<view class="itemTitle">存货：</view>
			<input value="{{ searchForm.inventory_name }}" class="searchInput" placeholder-class="placeholderClass" placeholder="请录入" bind:input="cunhuoInput" />
		</view>
		<view class="searchItem frbc">
			<view class="itemTitle">外径：</view>
			<input value="{{ searchForm.outer_diameter }}" class="searchInput" placeholder-class="placeholderClass" placeholder="请录入" bind:input="waijingInput" />
		</view>
		<view class="searchItem frbc">
			<view class="itemTitle">壁厚：</view>
			<input value="{{ searchForm.wall_thickness }}" class="searchInput" placeholder-class="placeholderClass" placeholder="请录入" bind:input="bihouInput" />
		</view>
		<view class="searchItem frbc" style="border: 0;">
			<view class="itemTitle">长度：</view>
			<input value="{{ searchForm.length }}" class="searchInput" placeholder-class="placeholderClass" placeholder="请录入" bind:input="changduInput" />
		</view>
	</view>
	<view class="btnBox frcc" bind:tap="goInventoryResult">
		<image src="/images/inventoryModule/fangdajing.png" mode="" style="width: 36rpx; height: 36rpx;"/>
		<view class="btnText">查一查</view>
	</view>
</view>