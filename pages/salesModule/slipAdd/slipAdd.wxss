.slipAddPage {
  min-height: 100vh;
  background-color: rgba(232, 238, 255, 1);
}

.wxtsbox {
  padding: 0 20rpx;
  height: 84rpx;
  background-color: #FFEDED;
}

.wxtstext {
  width: calc(100% - 60rpx);
  color: #FF7373;
}

.slipAddBox {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #fff;
}

.slipAddItem {
  padding: 20rpx;
  border-bottom: 1rpx solid #ECECEC;
}

.itemTitle {
	min-width: 120rpx;
  font-size: 28rpx;
  line-height: 48rpx;
  color: rgba(51, 51, 51, 1);
}

.radiotext {
  font-size: 28rpx;
  line-height: 48rpx;
  color: rgba(51, 51, 51, 1);
}

.slipAddInput {
  padding-right: 10rpx;
  text-align: right;
  font-size: 30rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: #333;
}

.slipAddInput2 {
  margin: 0 20rpx;
  width: 80rpx;
  text-align: right;
  font-size: 30rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: #333;
  border: 1rpx solid #E5E5E5;
  border-radius: 8rpx;
}

.slipAddInput3 {
  margin: 0 20rpx;
  font-size: 30rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: #333;
  border-radius: 8rpx;
}

.inputText {
  font-size: 28rpx;
  line-height: 48rpx;
  color: rgba(51, 51, 51, 1);
}

.placeholderClass {
  font-size: 28rpx;
  line-height: 48rpx;
  color: #cccccc;
}

.textareaBox {
  margin: 20rpx 0;
  font-weight: 500;
  min-height: 144rpx;
}

.saveBtnBox {
  /* margin-top: 280rpx; */
  margin-top: 20rpx;
  padding: 30rpx 40rpx;
  background-color: #fff;
}

.saveBtn {
  height: 100rpx;
  border-radius: 12px;
  background: #2A82E4;
  font-size: 32rpx;
  line-height: 32rpx;
  color: rgba(255, 255, 255, 1);
}

.biaotistyle {
  padding-left: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.shanchustyle {
  display: block;
  padding: 10rpx;
  width: 36rpx;
  height: 36rpx;
}

.tianjiafangstyle {
  margin: 40rpx auto;
  display: block;
  width: 80rpx;
  height: 80rpx;
}