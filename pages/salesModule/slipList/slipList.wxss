.slipListPage {
  padding: 20rpx 20rpx;
  min-height: calc(100vh - 44px);
  background-color: rgba(232, 238, 255, 1);
}

.slipItem {
  margin-bottom: 20rpx;
  padding: 30rpx 20rpx;
  opacity: 1;
  border-radius: 10rpx;
  background: #FFFFFF;
  box-shadow: 4rpx 8rpx 20rpx #E6EBFA;
}

