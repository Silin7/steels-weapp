<van-tabs active="{{ sliptype }}" color="#2D56EB" bind:change="tabChange">
  <van-tab title="全部" name='1'></van-tab>
  <van-tab title="待审核" name='2'></van-tab>
  <van-tab title="待发货" name='3'></van-tab>
  <van-tab title="已发货" name='4'></van-tab>
</van-tabs>
<scroll-view scroll-y="{{ true }}" refresher-enabled="{{ true }}" refresher-triggered="{{ triggered }}" bindrefresherrefresh="permessagerePull" bindscrolltolower="onScrollBottom" style="height: calc(100vh - 88rpx);">
  <view class="slipListPage">
    <view wx:for="{{ slipData }}" wx:key="index" class="slipItem" bind:tap="goSlipDetail">
      <view class="frbc" style="padding-bottom: 20rpx;">
        <view class="dingdanhao">订单号：GW202503011103</view>
        <view class="dingdanzhuangtai">待发货</view>
      </view>
      <view class="centerbox">
        <view class="frsc">
          <view class="centeritemz">车号：</view>
          <view class="centeritemy">鲁PJ0866</view>
        </view>
        <view class="frsc">
          <view class="centeritemz">物流电话：</view>
          <view class="centeritemy">18238655336</view>
        </view>
        <view class="frsc">
          <view class="centeritemz">品名：</view>
          <view class="centeritemy">无缝化</view>
        </view>
        <view class="frsc">
          <view class="centeritemz">规格：</view>
          <view class="centeritemy">89*5*9380</view>
        </view>
        <view class="frsc">
          <view class="centeritemz">数量：</view>
          <view class="centeritemy">380支</view>
        </view>
      </view>
      <view class="frbc">
        <view>
          <view class="xiadanshijian">下单时间：</view>
          <view class="xiadanshijian">2025-03-01 10:09</view>
        </view>
        <view class="danleixing">销售单</view>
      </view>
    </view>
    <view wx:if="{{ slipData.length === 0 }}" class="nodataBox">
      <image src="/images/systemModule/zwsj.png" mode="aspectFill" />
    </view>
  </view>
</scroll-view>