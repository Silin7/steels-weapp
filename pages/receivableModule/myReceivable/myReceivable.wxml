<scroll-view scroll-y="{{ true }}" refresher-enabled="{{ true }}" refresher-triggered="{{ triggered }}" bindrefresherrefresh="permessagerePull" bindscrolltolower="onScrollBottom" style="height: 100vh;">
	<view class="myReceivablePage">
		<view wx:for="{{ slipData }}" wx:key="index" class="slipItem" bind:tap="goReceivableList" data-item="{{ item }}">
			<view style="padding-bottom: 20rpx;">
				<view class="gongsimingcheng">{{ item.customer_name }}</view>
			</view>
			<view class="frsc contentItem">
				<view class="centeritemz">客户已支付：</view>
				<view class="centeritemy">{{ item.paid_amount }}</view>
			</view>
			<view class="frsc contentItem">
				<view class="centeritemz">出库单费用合计：</view>
				<view class="centeritemy">{{ item.delivery_total }}</view>
			</view>
			<view wx:if="{{ item.receivable_amount <= 0 }}"  class="frsc contentItem">
				<view class="centeritemz">应收：</view>
				<view class="centeritemy" style="color: red;">{{ item.receivable_amount < 0 ? -item.receivable_amount : item.receivable_amount }}</view>
			</view>
			<view wx:if="{{ item.receivable_amount > 0 }}"  class="frsc contentItem">
				<view class="centeritemz">余额：</view>
				<view class="centeritemy" style="color: #2D56EB;">{{ item.receivable_amount }}</view>
			</view>
			<view class="frbc">
				<view></view>
				<view class="danleixing">查看出库单</view>
			</view>
		</view>
		<view wx:if="{{ slipData.length === 0 }}" class="nodataBox">
			<image src="/images/systemModule/zwsj.png" mode="aspectFill" />
		</view>
	</view>
</scroll-view>