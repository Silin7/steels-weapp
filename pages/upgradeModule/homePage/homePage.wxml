<view class="homePage">
  <!-- banner -->
  <view class="bannerBox">
    <swiper indicator-dots="{{ false }}" autoplay="{{ true }}" interval="5000" circular="{{ true }}" bindchange="swiperChange" style="height: 382rpx;">
      <block wx:for="{{ swiperList }}" wx:key="index">
        <swiper-item>
          <image src="{{ baseURL + item }}" mode="" class="bannerImage" style="width: 100%; height: 382rpx;" />
        </swiper-item>
      </block>
    </swiper>
    <!-- banner - dian -->
    <view class="swiperDianBox frcc">
      <view wx:for="{{ swiperList.length }}" wx:key="idnex">
        <view wx:if="{{ swiperCurrent === index }}" class="swiperDianA"></view>
        <view wx:else class="swiperDianN"></view>
      </view>
    </view>
    <view class="subBox frbc">
      <view class="subTitle fccc">
        <text>通知</text>
        <text>公告</text>
      </view>
      <view class="noticeBox">
        <view wx:for="{{ noticeData }}" wx:key="index" class="noticeItem">
          <text style="margin-right: 10rpx; color: #1446A7;">◆</text>{{ item.title }}
        </view>
      </view>
    </view>
  </view>
  <!-- 选择县区 -->
  <view class="countyDistrict">
    <view class="countyTitle frcc">
      <text class="lingxing1">◆</text>
      <text class="lingxing2">◆</text>
      请选择区县
      <text class="lingxing2">◆</text>
      <text class="lingxing1">◆</text>
    </view>
    <view class="frbc" style="flex-wrap: wrap;">
      <view wx:for="{{ areaData }}" wx:key="index" class="{{ activeArea === item ? 'countyActive' : 'countyItem' }}">{{ item }}</view>
    </view>
  </view>
</view>