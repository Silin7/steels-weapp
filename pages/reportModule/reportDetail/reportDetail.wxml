<view class="reportDetailPage">
  <view class="reportDetail">
    <view class="reportDanwei">
      <view class="frsc">
        <view class="pparitor">{{ reportForm.target_name }}</view>
        <view class="misconduct" style="{{ reportForm.target_name ? 'margin-left: 24rpx;' : '' }} ">{{ reportForm.type }}</view>
      </view>
      <view wx:if="{{ reportForm.status === '已答复' }}" class="reportDate">{{ reportForm.extra.mark_date }}</view>
      <view wx:if="{{ reportForm.status === '待处理' }}" class="reportDate">{{ reportForm.extra.create_date }}</view>
      <view class="gang"></view>
    </view>
    <view class="describeBox">
      <view class="describe">{{ reportForm.message }}</view>
      <view class="imageBox">
        <view wx:for="{{ reportForm.attachments }}" wx:key="index">
          <image src="https://api.gxrqzfsm.com{{ item.url }}" mode="aspectFill" bind:tap="previewImage" data-url="{{ item.url }}" />
        </view>
      </view>
      <view wx:if="{{ reportForm.need_reply }}" class="companyBox">
        <image src="/images/reportModule/kuang.png" mode="aspectFill" />
        <view class="companyFlex">
          <view class="frsc">
            <view class="companyName">{{ reportForm.company.name }}</view>
            <view class="gang2"></view>
            <view class="reportType">实名举报</view>
          </view>
          <view class="replyPhone">答复手机号：{{ reportForm.phone }}</view>
        </view>
      </view>
    </view>
    <view class="answeredBtn frcc">{{ reportForm.status }}</view>
  </view>
</view>