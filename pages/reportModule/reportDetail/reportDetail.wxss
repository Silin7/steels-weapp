.reportDetailPage {
  padding: 25rpx 20rpx;
  min-height: 100vh;
  background-color: #F0F5F9;
}

.reportDetail {
  padding-bottom: 87rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.reportDanwei {
  padding: 54rpx 35rpx;
}

.pparitor {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 46rpx;
  color: #1446A7;
}

.misconduct {
  padding: 12rpx 18rpx;
  font-size: 30rpx;
  font-weight: bold;
  font-family: PingFang SC;
  border-radius: 10rpx;
  color: #FFFFFF;
  background: #FC8D16;
}

.reportDate {
  margin-top: 32rpx;
  font-weight: 400;
  font-size: 27rpx;
  font-family: PingFang SC;
  color: #666666;
}

.gang {
  margin-top: 32rpx;
  height: 2rpx;
  background: #F2F2F2;
}

.describeBox {
  margin: 0 32rpx;
}

.describe {
  margin-top: 35rpx;
  font-size: 30rpx;
  font-weight: 500;
  font-family: PingFang SC;
  color: #333333;
}

.imageBox {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.imageBox image {
  box-sizing: border-box;
  margin-top: 48rpx;
  flex-shrink: 0;
  width: 305rpx;
  height: 229rpx;
  border: 1rpx solid #F0F5F9;
}

.companyBox {
  box-sizing: border-box;
  position: relative;
  margin-top: 144rpx;
  height: 181rpx;
}

.companyBox image {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 181rpx;
}

.companyFlex {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 0;
  padding: 36rpx 44rpx;
  width: 100%;
  height: 181rpx;
}

.companyName {
  margin-right: 24rpx;
  font-size: 34rpx;
  font-weight: bold;
  font-family: PingFang SC;
  color: #3185DB;
}

.gang2 {
  width: 2rpx;
  height: 34rpx;
  background-color: #ccc;
}

.reportType {
  margin-left: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  font-family: PingFang SC;
  color: #ea0000;
}

.replyPhone {
  margin-top: 21rpx;
  font-size: 30rpx;
  font-weight: 500;
  font-family: PingFang SC;
  color: #333333;
}

.answeredBtn {
  margin: 76rpx 34rpx 0 34rpx;
  height: 95rpx;
  font-size: 34rpx;
  font-weight: 500;
  font-family: PingFang SC;
  border-radius: 19rpx;
  color: #FFFFFF;
  background: #10BC85;
}