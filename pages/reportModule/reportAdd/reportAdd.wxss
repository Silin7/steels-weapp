.reportAddPage {
  padding: 20rpx;
  min-height: 100vh;
  background-color: rgba(232, 238, 255, 1);
}

.nameBox {
  margin-bottom: 20rpx;
  padding: 34rpx 32rpx;
  background-color: #fff;
  border-radius: 18rpx;
}

.checkedColor {
  margin-left: 10rpx;
  font-size: 30rpx;
  font-weight: normal;
  font-family: Adobe Heiti Std;
  color: #0B62BB;
}

.uncheckedColor {
  margin-left: 10rpx;
  font-size: 30rpx;
  font-weight: normal;
  font-family: Adobe Heiti Std;
  color: #CCCCCC;
}

.enterpriseBox {
  margin-bottom: 20rpx;
  padding: 34rpx 32rpx;
  background-color: #fff;
  border-radius: 18rpx;
}

.enterpriseInput {
  padding-right: 10rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  font-family: PingFang SC;
}

.typesBox {
  margin-bottom: 20rpx;
  padding: 34rpx 32rpx;
  background-color: #fff;
  border-radius: 18rpx;
}

.moniPlaceholder {
  padding-right: 10rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 500;
  color: #CCC;
  font-family: PingFang SC;
}

.moniValue {
  padding-right: 10rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  font-family: PingFang SC;
}

.reflectingUnit {
  margin-top: 60rpx;
  font-weight: 500;
  font-size: 30rpx;
  color: #333333;
  font-family: PingFang SC;
}

.reflectingUnitInput {
  margin: 26rpx 122rpx 0;
  padding-left: 23rpx;
  height: 73rpx;
  font-size: 30rpx;
  line-height: 30rpx;
  font-weight: 500;
  font-family: PingFang SC;
  border-radius: 18rpx;
  color: #333;
  border: 1rpx solid #686868;
}

.placeholderClass {
  color: #CCCCCC;
}

.describeBox {
  margin-bottom: 20rpx;
  padding: 34rpx 32rpx 14rpx;
  background-color: #fff;
  border-radius: 18rpx;
}

.textareaBox {
  margin: 20rpx 0;
  min-height: 144rpx;
}

.describeTextarea {
  font-size: 30rpx;
  color: #333;
  font-family: PingFang SC;
}

.uploadImgFlag {
  position: relative;
}

.closeImg {
  position: absolute;
  z-index: 2;
  right: 20rpx;
  top: 0rpx;
  width: 60rpx;
  height: 60rpx;
}

.uploadImg {
  margin: 0 20rpx 20rpx 0;
  width: 190rpx;
  height: 190rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(232, 238, 255, 1);
}

.replyBox {
  margin-bottom: 20rpx;
  padding: 34rpx 32rpx;
  background-color: #fff;
  border-radius: 18rpx;
}

.itemTitle {
  width: 180rpx;
  font-weight: 500;
  font-size: 30rpx;
  font-family: PingFang SC;
  color: #333333;
}

.itemTitle2 {
  font-weight: 500;
  font-size: 30rpx;
  font-family: PingFang SC;
  color: #333333;
}

.switchChecked {
  margin-right: 10rpx;
  font-size: 30rpx;
  font-weight: normal;
  font-family: Adobe Heiti Std;
  color: #1446A7;
}

.unswitchChecked {
  margin-right: 10rpx;
  font-size: 30rpx;
  font-weight: normal;
  font-family: Adobe Heiti Std;
  color: #CCCCCC;
}

.replyInput {
  margin: 26rpx 0 0;
  padding-left: 23rpx;
  height: 73rpx;
  font-size: 30rpx;
  line-height: 30rpx;
  font-weight: 500;
  text-align: center;
  font-family: PingFang SC;
  border-radius: 18rpx;
  color: #333;
}

.saveBtn {
  margin: 50rpx 0;
  height: 104rpx;
  font-size: 36rpx;
  font-weight: 400;
  font-family: PingFang SC;
  border-radius: 20rpx;
  color: #FFFFFF;
  background: #326ED1;
}