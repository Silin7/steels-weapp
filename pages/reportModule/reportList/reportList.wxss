.reportListPage {
  padding: 22rpx 20rpx;
  min-height: 100vh;
  background-color: rgba(232, 238, 255, 1);
}

.reportItem {
  margin-bottom: 22rpx;
  padding: 33rpx 20rpx 33rpx 33rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.reportTop {
  display: flex;
}

.imitateImage {
  flex-shrink: 0;
  width: 152rpx;
  height: 152rpx;
  font-size: 39rpx;
  font-weight: bold;
  line-height: 47rpx;
  font-family: PingFang SC;
  border-radius: 32rpx;
  color: #FFFFFF;
}

.titleDateBox {
  margin-left: 32rpx;
}

.reportTitle {
  margin-top: 14rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 34rpx;
  color: #333333;
}

.reportDate {
  margin-top: 30rpx;
  height: 21rpx;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 27rpx;
  color: #666666;
}

.answered {
  width: 153rpx;
  height: 68rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 30rpx;
  font-family: PingFang SC;
  border-radius: 34rpx;
  color: #FFFFFF;
  background: #10BC85;
}

.pending {
  width: 153rpx;
  height: 68rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 30rpx;
  font-family: PingFang SC;
  border-radius: 34rpx;
  color: #0B62BB;
  border: 2rpx solid #0B62BB;
}