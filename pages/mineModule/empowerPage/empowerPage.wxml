<!-- 角色选择 -->
<component-choosePicker pickerShow="{{ roleShow }}" pickerTitle="选择角色" dataList="{{ roleList }}" bind:confirmItem="confirmRole" />
<!-- 部门选择 -->
<component-choosePicker pickerShow="{{ departmentShow }}" pickerTitle="选择部门" dataList="{{ departmentList }}" bind:confirmItem="confirmDepartment" />

<view class="empowerPage">
  <view class="bannerBox">
    <view class="formBox">
      <view class="empower">授权登录</view>
      <view class="helloLogin">您好，欢迎登录</view>
      <view class="gang"></view>
      <view class="title">角色选择</view>
      <view class="moniField frbc" bind:tap="chooseRole">
        <view wx:if="{{ role_name }}" class="fieldValue">{{ role_name }}</view>
        <view wx:else class="moniPlaceholder">请选择您的角色</view>
        <image src="/images/mineModule/xiajiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
      </view>
      <view wx:if="{{ role_id === 4 }}">
        <view class="title">部门</view>
        <view class="moniField frbc" bind:tap="chooseDepartment">
          <view wx:if="{{ department_name }}" class="fieldValue">{{ department_name }}</view>
          <view wx:else class="moniPlaceholder">请选择您的部门</view>
          <image src="/images/mineModule/xiajiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
        </view>
      </view>
      <view class="title">昵称</view>
      <input type="nickname" value="{{ nickName }}" class="moniInput" placeholder-class="placeholderClass" placeholder="请输入" bind:input="nickNameInput" bind:change="nickNameInput" />
      <view class="loginBtn" bind:tap="authorizedLogin">点击授权登录</view>
    </view>
  </view>
</view>