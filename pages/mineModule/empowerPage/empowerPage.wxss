.empowerPage {
  min-height: 100vh;
  background-color: #F0F5F9;
}

.bannerBox {
  padding-top: 53rpx;
  width: 100%;
  height: 383rpx;
  background-color: #1446A7;
}

.formBox {
  padding: 97rpx 0 110rpx;
  margin: 0 24rpx;
  background-color: #fff;
  border-radius: 24rpx;
}

.empower {
  margin: 0 0 0 54rpx;
  height: 62rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 65rpx;
  color: #293247;
  line-height: 90rpx;
}

.helloLogin {
  margin: 33rpx 0 0 54rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #293247;
  font-family: PingFang SC;
}

.gang {
  margin: 65rpx 33rpx;
  height: 2rpx;
  background: #C5C5C5;
}

.title {
  margin-left: 91rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 32rpx;
  color: #293247;
}

.moniField {
  margin: 33rpx 82rpx;
  padding: 0 30rpx;
  height: 79rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  border: 1px solid #686868;
}

.moniPlaceholder {
  font-weight: 500;
  font-size: 30rpx;
  line-height: 30rpx;
  font-family: PingFang SC;
  color: #CCCCCC;
}

.moniInput {
  margin: 33rpx 82rpx;
  padding: 0 30rpx;
  height: 79rpx;
  font-size: 30rpx;
  line-height: 30rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1px solid #686868;
}

.placeholderClass {
  color: #cccccc;
}

.fieldValue {
  font-size: 30rpx;
  line-height: 30rpx;
  font-weight: 500;
  font-family: PingFang SC;
  color: #333333;
}

.loginBtn {
  margin: 172rpx 25rpx 0;
  height: 104rpx;
  font-size: 36rpx;
  line-height: 104rpx;
  text-align: center;
  font-family: PingFang SC;
  border-radius: 20rpx;
  color: #FFFFFF;
  background-color: #326ED1;
}