<view class="minePage">
  <view class="bannerBox">
    <!-- 未登录 -->
    <view wx:if="{{ !has_registered }}" class="userBox">
      <button class="agreeBtn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="goEmpowerPage"></button>
      <image src="{{ profile.profile.avatar || '/images/mineModule/profile_picture_no.png' }}" mode="aspectFill" style="width: 148rpx; height: 148rpx; border-radius: 50%;" />
      <view class="userInfo userName">授权登录</view>
    </view>
    <!-- 已登录 -->
    <view wx:else class="userBox">
      <view>
        <button class="avatarUrlBox" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar"></button>
        <image src="{{ profile.profile.avatar || '/images/mineModule/profile_picture_no.png' }}" mode="aspectFill" style="width: 148rpx; height: 148rpx; border-radius: 50%;" />
      </view>
      <view class="userInfo" bind:tap="goEmpowerPage">
        <view class="userName">{{ profile.role_name }}</view>
        <view class="userPhone">{{ profile.profile.name }}</view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="subBox">
      <view class="wenxintishi" wx:if="{{ has_registered && profile.profile.role_id === 4 }}">执法统计</view>
      <view class="wenxintishi" wx:else>温馨提示</view>
      <view class="gang"></view>
      <view class="mineBanner">
        <!-- 未注册 -->
        <image wx:if="{{ !has_registered }}" src="/images/mineModule/banner_wdl.png" mode="aspectFill" class="wh100" />
        <!-- 已注册 - 企业 -->
        <image wx:if="{{ has_registered && profile.profile.role_id === 5 }}" src="/images/mineModule/banner_qy.png" mode="aspectFill" class="wh100" />
        <!-- 已注册 - 执法人员 -->
        <view wx:if="{{ has_registered && profile.profile.role_id === 4 }}" class="frcc">
          <view class="recordItem fccc">
            <view class="recordValue">{{ profile.department.events_in_month }}</view>
            <view class="recordLabel">一个月执法记录</view>
          </view>
          <view class="recordItem fccc">
            <view class="recordValue">{{ profile.department.events_in_quarter }}</view>
            <view class="recordLabel">三个月内执法记录</view>
          </view>
        </view>
      </view>
      <!-- 已注册 - 企业 -->
      <view wx:if="{{ has_registered && profile.profile.role_id === 5 }}" class="shizhangBanner">
        <image src="/images/mineModule/banner_sz.png" mode="aspectFill" class="wh100" />
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view wx:if="{{ has_registered }}" class="commonTitle" style="{{ (has_registered && profile.profile.role_id === 5) ? 'margin-top: 432rpx;' : 'margin-top: 320rpx;' }}">常用功能</view>
  <view class="commonBox">
    <!-- 我的投诉 -->
    <view wx:if="{{ has_registered && profile.profile.role_id === 5 }}">
      <view class="commonItem frbc" bind:tap="goReportList">
        <view class="seekAdvice">我的投诉</view>
        <image src="/images/mineModule/youjiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
      </view>
      <view class="gang"></view>
    </view>
    <!-- 我的执法记录 -->
    <view wx:if="{{ has_registered && profile.profile.role_id === 4 }}">
      <view class="commonItem frbc" bind:tap="goExecuteList">
        <view class="seekAdvice">我的执法记录</view>
        <image src="/images/mineModule/youjiantou.png" mode="aspectFill" style="width: 30rpx; height: 30rpx;" />
      </view>
      <view class="gang"></view>
    </view>
    <!-- <view class="commonItem2 frbc">
      <view class="seekAdvice">咨询客服</view>
      <button open-type="contact" class="zxkfBtn">咨询客服</button>
    </view> -->
  </view>
</view>