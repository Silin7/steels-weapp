.minePage {
  background: linear-gradient(180deg, rgba(201, 216, 255, 1) 0%, rgba(232, 238, 255, 0) 100%);
}

.userBox {
  padding-top: 80rpx;
  position: relative;
  padding-left: 30rpx;
  display: flex;
}

.avatarImgae {
  width: 132rpx;
  height: 132rpx;
  opacity: 1;
  border: 4rpx solid rgba(255, 255, 255, 1);
  box-shadow: 0px 2px 4px rgba(45, 86, 235, 0.19);
  border-radius: 50%;
}

.agreeBtn {
  position: absolute;
  top: 0;
  left: 0;
  width: calc(100% - 60rpx);
  height: 160rpx;
  opacity: 0;
}

.avatarUrlBox {
  position: absolute;
  top: 80rpx;
  left: 40rpx;
  width: 140rpx;
  height: 140rpx;
  opacity: 0;
}

.userName {
  margin: 29rpx 0 0 30rpx;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 700;
  letter-spacing: 0px;
  color: rgba(47, 70, 173, 1);
}

.userPhone {
  margin: 20rpx 0 0 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
  font-family: PingFang SC;
  color: rgba(102, 102, 102, 1);
}

.subBox {
  margin: 56rpx 26rpx 0 26rpx;
  padding: 46rpx 32rpx 40rpx 32rpx;
  border-radius: 24rpx;
  background-color: #fff;
}

.wenxintishi {
  margin: 0 12rpx 46rpx 12rpx;
  font-size: 41rpx;
  font-weight: bold;
  line-height: 50rpx;
  color: #373737;
  font-family: PingFang SC;
}

.gang {
  width: 100%;
  height: 2rpx;
  background-color: #E9E9E9;
}

.mineBanner {
  margin: 20rpx auto 0;
  height: 210rpx;
}

.shizhangBanner {
  margin: 45rpx auto 0;
  width: 508rpx;
  height: 67rpx;
}

.recordItem {
  width: 50%;
  height: 210rpx;
}

.recordValue {
  font-size: 73rpx;
  font-weight: bold;
  font-family: PingFang SC;
  color: #064AB9;
}

.recordLabel {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  font-family: PingFang SC;
  color: #868686;
}

.commonTitle {
  margin-left: 64rpx;
  margin-bottom: 47rpx;
  /* margin: 320rpx 0 47rpx 64rpx; */
  font-size: 41rpx;
  font-weight: bold;
  line-height: 50rpx;
  font-family: PingFang SC;
  color: #373737;
}

.commonBox {
  margin: 0 26rpx;
  padding: 0 50rpx;
  border-radius: 24rpx;
  background-color: #fff;
}

.commonItem {
  padding: 46rpx 0;
}

.commonItem2 {
  padding: 40rpx 0;
}

.seekAdvice {
  font-size: 30rpx;
  font-weight: 500;
  font-family: PingFang SC;
  color: #373737;
}

.zxkfBtn {
  margin: 0 !important;
  width: 187rpx;
  height: 74rpx;
  font-size: 30rpx;
  font-weight: 500;
  font-family: PingFang SC;
  border-radius: 14rpx;
  color: #fff;
  background: #326ED1;
}

.bgBox {
  width: 100%;
  height: 540rpx;
}

.avatarBox {
  position: absolute;
  z-index: 2;
  top: 0;
  left: 0;
  width: 100%;
  height: 540rpx;
}

.avatarBgBox {
  margin: 70rpx auto 30rpx;
  width: 184rpx;
  height: 184rpx;
  border-radius: 180rpx;
  border: 4rpx solid #6096fd;
  background-color: #fff;
}

.nickName {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 34rpx;
  color: #FFFFFF;
  line-height: 34rpx;
}

.cardBox {
  padding: 60rpx 30rpx;
  background: #FFFFFF;
}

.cardItem {
  height: 120rpx;
}

.titleText {
  margin-left: 20rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 32rpx;
  line-height: 32rpx;
  color: rgba(51, 51, 51, 1);
}

.placeholderText {
  margin-right: 10rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #545454;
  line-height: 60rpx;
  color: rgba(153, 153, 153, 1);
}

.zxkfBtn {
  width: 100%;
  position: absolute;
  right: 0;
  z-index: 999;
  opacity: 0;
}

.wdxsdBox {
  margin: 40rpx 30rpx 20rpx;
  padding: 30rpx 30rpx 20rpx 30rpx;
  border-radius: 5px;
  background: rgba(255, 255, 255, 1);
  box-shadow: 4rpx 10rpx 20rpx rgba(230, 235, 250, 1);
}

.wdxsdTitle {
  margin-bottom: 40rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 32rpx;
  color: rgba(0, 0, 0, 1);
}

.wdxsdItem {
  padding: 20rpx 40rpx;
}

.wdxsdImage {
  width: 60rpx;
  height: 60rpx;
}

.wdxsdItemText {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 30rpx;
  color: rgba(51, 51, 51, 1);
}